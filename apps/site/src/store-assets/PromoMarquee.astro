---
import IframeWindow from "../components/BrowserWindow/IframeWindow.astro";
import StoreAssetLayout from "./StoreAssetLayout.astro";
import projectConfig from "../../../../project.config.json";
import logo from "../../../../assets/logo.svg";

const PRODUCT_NAME = projectConfig.product.name;
const copy = {
  "zh-CN": {
    description: `${PRODUCT_NAME} 顶部宣传图块`,
    label: "开源 · 新标签页",
    headline: {
      first: "搜索网页，",
      second: "打开常用网站。",
    },
    supporting: "使用浏览器书签作为网站快捷入口。搜索网页和书签。",
    features: ["网页搜索", "书签文件夹", "拖拽整理"],
    previewTitle: `${PRODUCT_NAME} 产品预览`,
    tabTitle: "新标签页",
  },
  en: {
    description: `${PRODUCT_NAME} marquee promotional tile`,
    label: "Open source · New tab",
    headline: {
      first: "Search the web,",
      second: "open saved sites.",
    },
    supporting:
      "Use browser bookmarks as site shortcuts. Search the web and your bookmarks.",
    features: ["Web search", "Bookmark folders", "Drag and drop"],
    previewTitle: `${PRODUCT_NAME} product preview`,
    tabTitle: "New Tab",
  },
} as const;

interface Props {
  locale: "zh-CN" | "en";
}

const { locale } = Astro.props;
const content = copy[locale];
---

<StoreAssetLayout locale={locale} viewport="1400x560" waitForApp>
  <section
    data-store-asset-canvas
    aria-label={content.description}
    class="relative isolate h-[560px] w-[1400px] shrink-0 overflow-hidden bg-paper bg-[linear-gradient(rgba(30,30,30,.085)_1px,transparent_1px),linear-gradient(90deg,rgba(30,30,30,.085)_1px,transparent_1px)] bg-[size:56px_56px]"
  >
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_18%_34%,rgba(255,255,255,.94),rgba(251,250,247,.62)_42%,rgba(251,250,247,.82)_100%)]"
    >
    </div>
    <img
      aria-hidden="true"
      class="pointer-events-none absolute bottom-[-178px] left-[-86px] -z-10 size-[360px] rotate-[-12deg] opacity-[.035]"
      src={logo.src}
      alt=""
    />

    <header class="absolute left-[72px] top-[46px] z-20 w-[438px]">
      <div class="inline-flex items-center gap-3">
        <img class="size-9" src={logo.src} alt="" aria-hidden="true" />
        <span class="text-[18px] font-bold tracking-[-.035em]"
          >{PRODUCT_NAME}</span
        >
      </div>

      <div
        class="mt-7 flex items-center gap-2 font-mono text-[10px] font-medium uppercase tracking-[.14em] text-[#716d67]"
      >
        <span class="size-1.5 rounded-full bg-brand shadow-[0_0_0_4px_#ffebe4]"
        ></span>
        <span>{content.label}</span>
      </div>

      <h1
        class:list={[
          "mb-0 mt-4 text-[52px] font-semibold leading-[1.02]",
          locale === "zh-CN" ? "tracking-[-.018em]" : "tracking-[-.055em]",
        ]}
      >
        <span class="block whitespace-nowrap">{content.headline.first}</span
        ><span class="block whitespace-nowrap">{content.headline.second}</span>
      </h1>
      <p
        class="mb-0 mt-5 max-w-[390px] text-[16px] font-medium leading-relaxed tracking-[-.012em] text-[#68645e]"
      >
        {content.supporting}
      </p>

      <div class="mt-7 flex flex-wrap gap-2.5">
        {
          content.features.map((feature) => (
            <span class="inline-flex items-center gap-2 rounded-full border border-black/[.09] bg-white/70 px-3.5 py-2 text-[11px] font-semibold tracking-[-.01em] text-[#59554f] shadow-[0_5px_18px_rgba(35,28,20,.04)]">
              <span class="size-1.5 rounded-full bg-brand" />
              <span>{feature}</span>
            </span>
          ))
        }
      </div>
    </header>

    <div
      class="absolute left-[520px] top-[42px] z-10 w-[1000px] rotate-[-1deg]"
    >
      <IframeWindow
        url={`/app/index.html?lang=${locale}`}
        title={content.previewTitle}
        tabTitle={content.tabTitle}
        scale={0.76}
      />
    </div>
  </section>
</StoreAssetLayout>
