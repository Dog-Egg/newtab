{
  "name": "@project/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "predev:ext": "pnpm run generate:extension-icons",
    "dev:ext": "vite build --mode extension --watch",
    "build:web": "tsc && vite build --mode web",
    "prebuild:ext": "pnpm run generate:extension-icons",
    "build:ext": "tsc && vite build --mode extension",
    "analyze:web": "ANALYZE=true pnpm run build:web",
    "analyze:ext": "ANALYZE=true pnpm run build:ext",
    "generate:extension-icons": "node scripts/generate-extension-icons.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/dom": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@tanstack/react-hotkeys": "0.27.0",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.9",
    "sonner": "^2.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.33",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
